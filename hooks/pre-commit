#!/bin/sh
# Keeps src/content/notes/ in sync with ~/vault before every commit, so you
# never have to remember to run this by hand. Safe to run unconditionally:
# sync-vault.mjs no-ops if ~/vault isn't present (e.g. CI, another machine
# without the vault cloned), and never touches anything outside notes/.
node scripts/sync-vault.mjs
git add src/content/notes/
