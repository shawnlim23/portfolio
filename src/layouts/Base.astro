---
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} — Shawn Lim</title>
	</head>
	<body>
		<header class="site-header">
			<a class="wordmark" href="/">Shawn Lim</a>
			<nav>
				<a href="/" aria-current={isCurrent('/') && path === '/' ? 'page' : undefined}>Work</a>
				<a href="/about" aria-current={isCurrent('/about') ? 'page' : undefined}>About</a>
				<a href="/essays" aria-current={isCurrent('/essays') ? 'page' : undefined}>Essays</a>
			</nav>
		</header>
		<main>
			<slot />
		</main>
	</body>
</html>
