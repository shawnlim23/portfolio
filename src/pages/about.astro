---
import Base from '../layouts/Base.astro';

type Entry = {
  company: string;
  role: string;
  year: string;
  icon?: string;
};

const experience: Entry[] = [
  {
    company: 'Co-Museum',
    role: 'Founding Team Member & Head of Operations',
    year: 'Dec 2022 — Jul 2026',
    icon: '/logos/co-museum.png',
  },
  {
    company: 'PetRock Capital',
    role: 'Quantitative Engineer',
    year: 'Jul 2022 — Dec 2022',
    icon: '/logos/petrock.png',
  },
  {
    company: 'COGLOBO GmbH',
    role: 'Full Stack Developer',
    year: 'Jan 2021 — Apr 2022',
    icon: '/logos/coglobo.jpg',
  },
  {
    company: 'Republic of Singapore Air Force',
    role: 'Lieutenant, Air Warfare Officer',
    year: 'Aug 2015 — Aug 2017',
    icon: '/logos/rsaf.png',
  },
];

const education: Entry[] = [
  {
    company: 'Singapore Institute of Technology',
    role: 'BEng (Hons) Information & Communications Technology, Software Engineering',
    year: 'Singapore',
    icon: '/logos/sit.png',
  },
  {
    company: 'Nanyang Polytechnic',
    role: 'Diploma in Digital Media Design, Interaction Design',
    year: 'Singapore',
    icon: '/logos/nyp.png',
  },
  {
    company: 'Hwa Chong Institution',
    role: 'Integrated Programme',
    year: 'Singapore',
    icon: '/logos/hci.png',
  },
];
---

<Base title="About">
	<div class="about-hero">
		<div class="about-text prose">
			<h1>Hi, I'm Shawn!</h1>
			<p>
				I'm based in Singapore, and if there's one thing that's stayed
				constant, it's that I'm insatiably curious. I'm always trying to
				learn and figure out how things work.
			</p>
			<p>
				I'm a builder, first and always. Outside of work I keep an
				ever-growing knowledge base of the ideas I'm chewing on, and I'm
				slowly turning that into more of a habit than it's been so far.
				Right now, that mostly looks like building AI agents and tooling
				for myself: a job-search scanner that watches company career pages,
				a small team of agents I'm assembling piece by piece, and an
				autonomous creative agent I'm building from scratch as a side
				project.
			</p>
			<p>
				I'd call myself a generalist above almost anything else, genuinely
				curious about a wide spread of things: design, technology,
				financial markets, and whatever's happening in the world that week.
				I'd rather move on something and figure it out along the way than
				wait for a clear lane to appear first.
			</p>
			<p>
				Professionally, I spent the last few years as the first hire and
				effectively the entire operating team at a small blockchain-native
				cultural institution, which meant learning fast, wearing whatever
				hat the week required, and getting comfortable being the only
				person in the room who could pick something up.
			</p>
		</div>
		<div class="about-photo">
			<span>Add photo</span>
		</div>
	</div>

	<section class="entry-section">
		<h2>Experience</h2>
		<ul class="entry-list">
			{experience.map((entry) => (
				<li class="entry-item">
					<div class={`entry-icon${entry.icon ? '' : ' entry-icon--letter'}`}>{entry.icon ? <img src={entry.icon} alt="" /> : entry.company.charAt(0)}</div>
					<div class="entry-text">
						<div class="entry-title">{entry.company}</div>
						<div class="entry-company">{entry.role}</div>
					</div>
					<div class="entry-year">{entry.year}</div>
				</li>
			))}
		</ul>
	</section>

	<section class="entry-section">
		<h2>Education</h2>
		<ul class="entry-list">
			{education.map((entry) => (
				<li class="entry-item">
					<div class={`entry-icon${entry.icon ? '' : ' entry-icon--letter'}`}>{entry.icon ? <img src={entry.icon} alt="" /> : entry.company.charAt(0)}</div>
					<div class="entry-text">
						<div class="entry-title">{entry.company}</div>
						<div class="entry-company">{entry.role}</div>
					</div>
					<div class="entry-year">{entry.year}</div>
				</li>
			))}
		</ul>
	</section>

	<section class="prose">
		<p>
			Always happy to talk to anyone building something, or just thinking
			through an idea out loud, and always open to the next interesting
			opportunity. Reach out on <a href="https://www.linkedin.com/in/shawnlim23/" target="_blank" rel="noopener">LinkedIn</a>.
		</p>
		<p>Email me at <a href="mailto:limweimingshawn@gmail.com">limweimingshawn@gmail.com</a></p>
	</section>
</Base>
