---
import Base from '../layouts/Base.astro';

type Entry = {
  company: string;
  role: string;
  description: string;
  year: string;
  icon?: string;
};

const experience: Entry[] = [
  {
    company: 'Co-Museum',
    role: 'Founding Team Member & Head of Operations',
    description:
      'Deployed Ethereum/Polygon smart contracts and fiat on-ramp payment infra for blockchain-based products with AMBUSH®, Billionaire Boys Club, and Azuki — $1M+ revenue, contributed to an $18M pre-seed raise.',
    year: 'Dec 2022 — Feb 2026',
  },
  {
    company: 'PetRock Capital',
    role: 'Quantitative Engineer',
    description:
      'Built proprietary algorithmic trading strategies and end-to-end automated trading systems across multiple blockchain networks.',
    year: 'Jul 2022 — Dec 2022',
  },
  {
    company: 'COGLOBO GmbH',
    role: 'Full Stack Developer',
    description:
      'Built a graph-based CRM platform from 0 to 1 — React, GraphQL, Neo4j, AWS — normalizing ~10K rows of relational data into a graph structure.',
    year: 'Jan 2021 — Apr 2022',
  },
  {
    company: 'Republic of Singapore Air Force',
    role: 'Lieutenant, Air Warfare Officer',
    description:
      'Led a team of 6–8 personnel in an operational unit, overseeing mission execution and day-to-day administration.',
    year: 'Aug 2015 — Aug 2017',
  },
];

const education: Entry[] = [
  {
    company: 'Singapore Institute of Technology',
    role: 'BEng (Hons) Information & Communications Technology, Software Engineering',
    description: 'GPA 4.45/5.00',
    year: '2018 — 2021',
  },
  {
    company: 'Nanyang Polytechnic',
    role: 'Diploma in Digital Media Design, Interaction Design',
    description: "GPA 3.64/4.00 — Director's List (Top 15%), 3 semesters",
    year: '2012 — 2015',
  },
];
---

<Base title="About">
	<div class="about-hero">
		<div class="about-text prose">
			<h1>Hi, I'm Shawn</h1>
			<p>Write this.</p>
		</div>
		<div class="about-photo">
			<span>Add photo</span>
		</div>
	</div>

	<section class="entry-section">
		<h2>Experience</h2>
		<ul class="entry-list">
			{experience.map((entry) => (
				<li class="entry-item">
					<div class="entry-icon">{entry.icon ? <img src={entry.icon} alt="" /> : entry.company.charAt(0)}</div>
					<div class="entry-text">
						<div class="entry-title">{entry.role}</div>
						<div class="entry-company">{entry.company}</div>
						<div class="entry-description">{entry.description}</div>
					</div>
					<div class="entry-year">{entry.year}</div>
				</li>
			))}
		</ul>
	</section>

	<section class="entry-section">
		<h2>Education</h2>
		<ul class="entry-list">
			{education.map((entry) => (
				<li class="entry-item">
					<div class="entry-icon">{entry.icon ? <img src={entry.icon} alt="" /> : entry.company.charAt(0)}</div>
					<div class="entry-text">
						<div class="entry-title">{entry.role}</div>
						<div class="entry-company">{entry.company}</div>
						<div class="entry-description">{entry.description}</div>
					</div>
					<div class="entry-year">{entry.year}</div>
				</li>
			))}
		</ul>
	</section>
</Base>
