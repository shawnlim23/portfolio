---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const notes = (await getCollection('notes')).filter((note) => note.data.publish);
  return notes.map((note) => ({ params: { id: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
---

<Base title={note.data.title}>
	<article class="prose">
		<h1>{note.data.title}</h1>
		{note.data.date && (
			<time datetime={note.data.date.toISOString()}>{note.data.date.toDateString()}</time>
		)}
		<Content />
	</article>
</Base>
