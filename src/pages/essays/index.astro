---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const notes = (await getCollection('notes'))
  .filter((note) => note.data.publish)
  .sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0));
---

<Base title="Essays">
	<h1>Essays</h1>
	{
		notes.length === 0 ? (
			<p>
				Nothing published yet — mark a vault note publish: true, run
				node scripts/sync-vault.mjs, and it shows up here.
			</p>
		) : (
			<ul>
				{notes.map((note) => (
					<li>
						<a href={`/essays/${note.id}`}>{note.data.title}</a>
						{note.data.date && (
							<time datetime={note.data.date.toISOString()}>
								{note.data.date.toDateString()}
							</time>
						)}
					</li>
				))}
			</ul>
		)
	}
</Base>
